generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String?  @unique
  password      String
  name          String
  avatar        String?
  bio           String?
  website       String?
  location      String?
  statusMessage String?
  moodEmoji     String?  // Vibe/mood status emoji
  isOnline      Boolean  @default(false)
  role          String   @default("USER") // USER, ADMIN
  isActive      Boolean  @default(true)
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())
  tier          Tier     @default(FREE)
  subscriptionId String? @unique
  points        Int      @default(0)
  xp            Int      @default(0)
  level         Int      @default(1)
  updatedAt     DateTime @updatedAt

  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  boosts           BoostRecord[]

  messages         Message[]
  conversations    Participant[]
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  messageReads     MessageRead[]

  // Feed & Stories
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  stories       Story[]
  storyViews    StoryView[]
  savedPosts    SavedPost[]
  closeFriends  CloseFriend[] @relation("CloseFriendOwner")
  closeFriendOf CloseFriend[] @relation("CloseFriendMember")
}

model Conversation {
  id            String   @id @default(uuid())
  name          String?
  avatar        String?
  isGroup       Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants Participant[]
  messages     Message[]
  polls        Poll[]
}

model Participant {
  id              String    @id @default(uuid())
  userId          String
  conversationId  String
  role            String    @default("MEMBER") // ADMIN, MEMBER
  joinedAt        DateTime  @default(now())
  isPinned        Boolean   @default(false)
  isMuted         Boolean   @default(false)
  muteUntil       DateTime?
  isArchived      Boolean   @default(false)
  lastReadAt      DateTime?

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
}

model Message {
  id             String    @id @default(uuid())
  content        String
  type           String    @default("TEXT") // TEXT, IMAGE, FILE, AUDIO, VIDEO, POLL
  attachmentUrl  String?
  senderId       String
  conversationId String
  status         String    @default("SENT") // SENT, DELIVERED, READ
  createdAt      DateTime  @default(now())
  
  // Deletion
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedForAll  Boolean   @default(false)
  
  // Forwarding
  isForwarded    Boolean   @default(false)
  forwardedFromId String?
  
  // Scheduling (Pro+)
  scheduledAt    DateTime?
  
  // Disappearing (Pro+)
  expiresAt      DateTime?

  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  replyToId      String?
  replyTo        Message?     @relation("ReplyTo", fields: [replyToId], references: [id])
  replies        Message[]    @relation("ReplyTo")
  reactions      Reaction[]
  reads          MessageRead[]
  forwardedFrom  Message?     @relation("ForwardedMessage", fields: [forwardedFromId], references: [id])
  forwardedTo    Message[]    @relation("ForwardedMessage")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

// In-chat Polls (Business tier)
model Poll {
  id             String   @id @default(uuid())
  question       String
  conversationId String
  creatorId      String
  isAnonymous    Boolean  @default(false)
  allowMultiple  Boolean  @default(false)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  options      PollOption[]
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String
  votes     PollVote[]

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model PollVote {
  id       String   @id @default(uuid())
  optionId String
  odedAt   DateTime @default(now())
  voterId  String

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, voterId])
}

model FriendRequest {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  from User @relation("SentRequests", fields: [fromId], references: [id])
  to   User @relation("ReceivedRequests", fields: [toId], references: [id])

  @@unique([fromId, toId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SystemConfig {
  key   String @id
  value String
}

model Report {
  id           String   @id @default(uuid())
  type         String
  reporterId   String
  targetId     String?
  reason       String
  description  String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  resolvedById String?
}

// --- Feed & Stories ---

model Post {
  id        String   @id @default(uuid())
  content   String?
  imageUrl  String?
  authorId  String
  likesCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
  boosts    BoostRecord[]
  savedBy   SavedPost[]
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author    User @relation(fields: [authorId], references: [id])
  post      Post @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
  post      Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Story {
  id            String   @id @default(uuid())
  mediaUrl      String
  type          String   @default("IMAGE")
  authorId      String
  expiresAt     DateTime
  closeFriendsOnly Boolean @default(false)
  createdAt     DateTime @default(now())

  author    User @relation(fields: [authorId], references: [id])
  views     StoryView[]
  reactions StoryReaction[]
}

model StoryView {
  id        String   @id @default(uuid())
  viewerId  String
  storyId   String
  viewedAt  DateTime @default(now())

  viewer    User  @relation(fields: [viewerId], references: [id])
  story     Story @relation(fields: [storyId], references: [id])

  @@unique([viewerId, storyId])
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model CloseFriend {
  id        String   @id @default(uuid())
  ownerId   String
  friendId  String
  createdAt DateTime @default(now())

  owner  User @relation("CloseFriendOwner", fields: [ownerId], references: [id])
  friend User @relation("CloseFriendMember", fields: [friendId], references: [id])

  @@unique([ownerId, friendId])
}

// --- SaaS & AI System ---

enum Tier {
  FREE
  PRO
  BUSINESS
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  planId    String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?
  plan Plan  @relation(fields: [planId], references: [id])
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  tier        Tier
  price       Float
  interval    String   @default("MONTHLY")
  features    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model BoostRecord {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])
}
